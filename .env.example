VITE_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
SESSION_SECRET=any-long-random-string
MIGRATE_SECRET=any-random-string
VITE_APP_MAIL_SECRET=any-random-string
RESEND_API_KEY=re_your_resend_api_key
# Optional — a separate key with full/account access, only for the
# ?checkEmailQuota=1 usage check. RESEND_API_KEY above should stay
# scoped to "sending emails only"; leave this unset if you don't need
# the usage check.
RESEND_USAGE_API_KEY=re_your_full_access_resend_api_key
MAIL_FROM=Ausgroup Dispatch <dispatch@yourdomain.com>
REPORT_RECIPIENTS=you@yourdomain.com
JOB_BACKUP_RECIPIENTS=you@yourdomain.com
CRON_SECRET=any-random-string
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-javascript-api-key
# Optional — a separate, server-side Google key (Maps Static API enabled,
# no HTTP-referrer restriction) used only to render the small map image
# embedded in attendance PDFs. VITE_GOOGLE_MAPS_API_KEY above won't work
# here: it's restricted to this app's own domains, and a server-to-server
# call never sends a Referer header for Google to check. Leave unset to
# keep using the OpenStreetMap-tile fallback already built in.
GOOGLE_STATIC_MAPS_API_KEY=your-google-maps-static-api-key
