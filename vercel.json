{
  "crons": [
    { "path": "/api/daily-report", "schedule": "30 20 * * *" }
  ],
  "functions": {
    "api/daily-report.js": { "maxDuration": 60 },
    "api/send-client-email.js": { "maxDuration": 60 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, must-revalidate" }
      ]
    }
  ]
}
